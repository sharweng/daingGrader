# ===========================================================
# Daing Grader Backend - Environment Configuration
# ===========================================================
# This file shows all required environment variables.
# Copy this file to .env and fill in your actual values.
# ===========================================================

# -----------------------------------------------------------
# Cloudinary Configuration (Image Storage)
# Get these from: https://cloudinary.com/console
# -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -----------------------------------------------------------
# MongoDB Configuration (Database)
# Free tier: https://www.mongodb.com/cloud/atlas
# -----------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=daing_grader

# -----------------------------------------------------------
# JWT Authentication (Web App)
# Set a strong random value in production
# -----------------------------------------------------------
JWT_SECRET=your-secret-key-change-in-production

# -----------------------------------------------------------
# CORS - Frontend URL (Production only)
# Example: https://dainggrader.vercel.app
# -----------------------------------------------------------
FRONTEND_URL=

# -----------------------------------------------------------
# Contact Form - Gmail SMTP
# 1. Use your Gmail address
# 2. Enable 2FA and create App Password:
#    https://myaccount.google.com/apppasswords
# -----------------------------------------------------------
CONTACT_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# -----------------------------------------------------------
# PayMongo Configuration (Payments)
# Get keys from: https://dashboard.paymongo.com/developers
# -----------------------------------------------------------
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key

# -----------------------------------------------------------
# Firebase Admin SDK (Optional - for Google Sign-In)
# Option 1: JSON string of service account
# Option 2: Path to service account JSON file
# -----------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# -----------------------------------------------------------
# Admin Registration Code (Web App)
# Required to register admin accounts
# -----------------------------------------------------------
ADMIN_CODE=DaingAdmin2026
